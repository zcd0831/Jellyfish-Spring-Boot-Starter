<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>zcd</groupId>
    <artifactId>jellyfish-spring-boot-starter</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Jellyfish Spring Boot Starter</name>
    <description>把 Jellyfish 内核接入已有的 Spring Boot 应用：装配、生命周期与门面 Bean。接口由接入方自己定义。</description>

    <properties>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 内核版本：开发期靠本地仓库的 SNAPSHOT（先在 Jellyfish 里 mvn install） -->
        <jellyfish.version>0.0.1-SNAPSHOT</jellyfish.version>

        <!-- 覆盖 Boot 的 BOM 属性，把 Jackson 对齐到内核构建所用的版本（内核 pom 的 jackson.version）。
             Boot 2.7.18 默认管 2.13.5，与内核差一个大版本；starter 自己的构建按内核那一份来，
             否则「内核在 2.21.6 上测过、starter 却在 2.13.5 上跑」这件事无人知晓。
             注意这只影响 starter 自身的构建：宿主应用最终 classpath 上的 Jackson 版本由宿主自己的
             BOM 决定，因此宿主若被压回 2.13.5，需要自行覆盖同一个属性（见 AGENTS.md）。 -->
        <jackson-bom.version>2.21.6</jackson-bom.version>

        <!-- 覆盖率：与内核 / 插件两个仓库同一条版本线（0.8.12 是仍支持 Java 8 运行时的最后一个主线） -->
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <dependencies>
        <!-- 装配层：传递带 jellyfish-api / jellyfish-infra / jellyfish-core。
             starter 只依赖它，不直接依赖三个内核模块——装配知识只有一处，见 AGENTS.md。 -->
        <dependency>
            <groupId>zcd</groupId>
            <artifactId>jellyfish-di</artifactId>
            <version>${jellyfish.version}</version>
        </dependency>

        <!-- 自动配置的地基。刻意不引 spring-boot-starter-web：本 starter 不提供任何 HTTP 接口，
             接口由接入方自己定义；强行带上 Web 栈等于替接入方决定技术选型。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- 生成 configuration-metadata.json，让 IDE 在 application.yml 里对 jellyfish.* 有补全与提示。
             编译期可见即可，因此 optional——它不该被传递到宿主应用的运行期 classpath 上。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 单元测试：JUnit5 + Mockito + AssertJ + ApplicationContextRunner（spring-test）由它统一带进来 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 覆盖率：与内核 / 插件仓库同口径（binding 到 test 阶段，报告落 target/site/jacoco） -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <!-- 配置类的 setter / getter 与纯常量类不纳入覆盖率统计 -->
                        <exclude>**/package-info.*</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
